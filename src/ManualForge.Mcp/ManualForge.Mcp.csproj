<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ManualForge.Mcp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ManualForge.Core\ManualForge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- What the server tells the client is worth testing directly: it is the whole of how Claude
         learns to use this library. -->
    <InternalsVisibleTo Include="ManualForge.Core.Tests" />
  </ItemGroup>

</Project>
