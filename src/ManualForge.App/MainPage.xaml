<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ManualForge.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ManualForge.Shell.ViewModels"
    xmlns:pipeline="using:ManualForge.Core.Pipeline"
    xmlns:indexing="using:ManualForge.Core.Indexing"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Folder, and what to do with it -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                PlaceholderText="Folder of PDFs"
                IsReadOnly="True"
                Text="{x:Bind ViewModel.Folder, Mode=OneWay}" />

            <Button Grid.Column="1" Content="Browse…" Click="BrowseAsync" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
            <Button Grid.Column="2" Content="Survey" Command="{x:Bind ViewModel.SurveyCommand}" />
            <Button Grid.Column="3" Content="Run" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RunCommand}" />
            <Button Grid.Column="4" Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
            <CheckBox Grid.Column="5" Content="Dry run" IsChecked="{x:Bind ViewModel.DryRun, Mode=TwoWay}" VerticalAlignment="Center" />
        </Grid>

        <!-- Status and overall progress -->
        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
            <ProgressBar Value="{x:Bind ViewModel.FileProgress, Mode=OneWay}" Maximum="100" />
        </StackPanel>

        <!-- Live counters, throughput, and the card -->
        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Files" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}">
                    <Run Text="{x:Bind ViewModel.FilesDone, Mode=OneWay}" />
                    <Run Text="/" />
                    <Run Text="{x:Bind ViewModel.FilesTotal, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{x:Bind ViewModel.CurrentFile, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                <TextBlock Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Pages" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}">
                    <Run Text="{x:Bind ViewModel.PagesDone, Mode=OneWay}" />
                    <Run Text="/" />
                    <Run Text="{x:Bind ViewModel.PagesTotal, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7">
                    <Run Text="{x:Bind ViewModel.PagesPerMinute, Mode=OneWay}" />
                    <Run Text="pages/min" />
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="2" MinWidth="220">
                <TextBlock Text="GPU" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <TextBlock Text="{x:Bind ViewModel.GpuStatus, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="busy" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <ProgressBar Grid.Column="1" Value="{x:Bind ViewModel.GpuUtilisation, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="vram" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <ProgressBar Grid.Column="1" Value="{x:Bind ViewModel.VramUsedPercent, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- The summary before committing, then what happened -->
        <TabView Grid.Row="3" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False">

            <TabViewItem Header="Classes" IsClosable="False">
                <Grid RowSpacing="8" Padding="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        TextWrapping="Wrap"
                        Opacity="0.8"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Survey classifies without changing anything. Class is what each file was when it was first classified; Done counts the files already finished, which a run leaves alone. Action is what a run does to the rest of the class." />

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Summary, Mode=OneWay}" SelectionMode="None">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="12,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Class" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Files" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Pages" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Done" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Action" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="What it means" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClassSummaryRow">
                                <Grid ColumnSpacing="12" MinHeight="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind TextClass}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Files}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Pages}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Done}" VerticalAlignment="Center" />
                                    <ComboBox
                                        Grid.Column="4"
                                        ItemsSource="{x:Bind AvailableActions}"
                                        SelectedItem="{x:Bind SelectedAction, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind Explanation}" TextWrapping="Wrap" Opacity="0.75" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Results" IsClosable="False">
                <Grid RowSpacing="8" Padding="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <Button Content="Export CSV…" Click="ExportCsvAsync" />
                        <Button Content="Export JSON…" Click="ExportJsonAsync" />
                    </StackPanel>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="pipeline:FileOutcome">
                                <Grid ColumnSpacing="12" MinHeight="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Status}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind PageCount}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind WordsWritten}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Problems" IsClosable="False">
                <Grid RowSpacing="8" Padding="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button
                        Grid.Row="0"
                        Content="Trim"
                        ToolTipService.ToolTip="Forget the records of files that are no longer on disk. Nothing on disk is touched."
                        Command="{x:Bind ViewModel.TrimMissingCommand}" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Errors, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Doctor" IsClosable="False">
                <Grid RowSpacing="8" Padding="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- What to do. Reading the audit is free; auditing is minutes; recovering is
                         GPU time, so it is the one with the accent on it and a count beside it. -->
                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Content="Read audit"
                            Command="{x:Bind Doctor.RefreshCommand}"
                            ToolTipService.ToolTip="Show what an earlier audit found. Changes nothing." />

                        <Button
                            Grid.Column="1"
                            Content="Audit folder"
                            Command="{x:Bind Doctor.AuditCommand}"
                            ToolTipService.ToolTip="Find pages whose text layer is incomplete. Changes nothing. Over a whole library this takes hours — run `manualforge doctor` for that." />

                        <Button
                            Grid.Column="2"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind Doctor.RepairCommand}"
                            ToolTipService.ToolTip="OCR the flagged pages of the ticked documents. No PDF is written to.">
                            <TextBlock>
                                <Run Text="Recover text" />
                                <Run Text="(" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Run Text="{x:Bind Doctor.SelectedCount, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Run Text=")" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                        </Button>

                        <Button
                            Grid.Column="3"
                            Content="Stop"
                            Command="{x:Bind Doctor.CancelCommand}" />

                        <!-- Over a whole library the list runs to several hundred rows, and the
                             difference between "repair what you suggested" and "repair these three"
                             should not be three hundred clicks. -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" Margin="16,0,0,0">
                            <Button Content="All" Command="{x:Bind Doctor.SelectEverythingCommand}" />
                            <Button Content="None" Command="{x:Bind Doctor.SelectNothingCommand}" />
                        </StackPanel>

                        <CheckBox
                            Grid.Column="5"
                            Content="Include scanned pages"
                            IsChecked="{x:Bind Doctor.IncludeScannedPages, Mode=TwoWay}"
                            IsEnabled="{x:Bind Doctor.IsIdle, Mode=OneWay}"
                            ToolTipService.ToolTip="Also redo scanned pages whose earlier OCR missed lettering. A different problem, and on a large library, hours of work." />
                    </Grid>

                    <!-- What this tab is for and the order to use it in: the results meant nothing
                         without it (#74). -->
                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock
                            TextWrapping="Wrap"
                            Opacity="0.8"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="The audit finds pages whose text layer misses what is printed on them, such as labels on schematics and tables drawn as graphics, which a search therefore cannot find. Recover text reads those pages and keeps what it finds for search; no PDF is changed. Then build the index on the Search tab, so search can find it. To check a finding first, click or tick a document and Show one of its pages." />
                        <TextBlock
                            Text="{x:Bind Doctor.Headline, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Spacing="4">
                        <TextBlock
                            Text="{x:Bind Doctor.Status, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Opacity="0.8"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <ProgressBar
                            Value="{x:Bind Doctor.WorkProgress, Mode=OneWay}"
                            IsIndeterminate="{x:Bind Doctor.IsWorkIndeterminate, Mode=OneWay}"
                            Maximum="100"
                            Visibility="{x:Bind Doctor.IsBusy, Mode=OneWay}" />
                    </StackPanel>

                    <!-- The findings on the left, and on the right the page the detector was
                         looking at, so nobody has to take its word for it before spending GPU
                         time on what it said. -->
                    <Grid Grid.Row="3" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="12" Padding="12,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="Document" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="Why" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="3" Text="Flagged" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="4" Text="Drawn" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="5" Text="Recovered" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>

                            <ListView
                                Grid.Row="1"
                                ItemsSource="{x:Bind Doctor.Documents, Mode=OneWay}"
                                SelectedItem="{x:Bind Doctor.SelectedDocument, Mode=TwoWay}"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DoctorRow">
                                        <Grid ColumnSpacing="12" MinHeight="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox
                                                Grid.Column="0"
                                                MinWidth="0"
                                                IsChecked="{x:Bind Selected, Mode=TwoWay}" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{x:Bind PageRanges}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Opacity="0.6"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{x:Bind Kind}" VerticalAlignment="Center" Opacity="0.8" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind FlaggedPages}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind DrawnPages}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind Progress, Mode=OneWay}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <ListView
                                Grid.Row="2"
                                MaxHeight="120"
                                ItemsSource="{x:Bind Doctor.Recovered, Mode=OneWay}"
                                SelectionMode="None" />
                        </Grid>

                        <Grid Grid.Column="1" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Show page" VerticalAlignment="Center" />
                                <NumberBox
                                    Grid.Column="1"
                                    Minimum="1"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind Doctor.ExplainPage, Mode=TwoWay}" />
                                <Button Grid.Column="2" Content="Show" Command="{x:Bind Doctor.ExplainCommand}" />
                            </Grid>

                            <!-- What the picture means for search, and whether this page needs anything (#74). -->
                            <TextBlock
                                Grid.Row="1"
                                Text="{x:Bind Doctor.PageExplanation, Mode=OneWay}"
                                Visibility="{x:Bind Doctor.HasPageExplanation, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}" />

                            <Border
                                Grid.Row="2"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid>
                                    <ScrollViewer x:Name="DiagnosticScroller" ZoomMode="Enabled" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto">
                                        <Image x:Name="DiagnosticImage" Stretch="Uniform" />
                                    </ScrollViewer>
                                    <TextBlock
                                        Text="{x:Bind Doctor.ExplainHint, Mode=OneWay}"
                                        Visibility="{x:Bind Doctor.HasNoPicture, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Opacity="0.7"
                                        Margin="16"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        TextAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                            </Border>

                            <!-- What a repair read off this page, to set against the black lettering. -->
                            <StackPanel Grid.Row="3" Spacing="4" Visibility="{x:Bind Doctor.HasPageRecoveredText, Mode=OneWay}">
                                <TextBlock Text="Text recovered from this page" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                                <ScrollViewer MaxHeight="140">
                                    <TextBlock
                                        Text="{x:Bind Doctor.PageRecoveredText, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True"
                                        FontFamily="Consolas"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Search" IsClosable="False">
                <Grid RowSpacing="8" Padding="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="which pins carry the HP-IB handshake"
                            Text="{x:Bind Search.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{x:Bind Search.IsIdle, Mode=OneWay}"
                            KeyDown="SearchKeyDown" />

                        <Button
                            Grid.Column="1"
                            Content="Search"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind Search.SearchCommand}" />

                        <Button
                            Grid.Column="2"
                            Content="Build index"
                            Command="{x:Bind Search.BuildIndexCommand}" />
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        Text="{x:Bind Search.Status, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Opacity="0.8"
                        Style="{StaticResource CaptionTextBlockStyle}" />

                    <ListView Grid.Row="2" ItemsSource="{x:Bind Search.Results, Mode=OneWay}" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="indexing:SearchHit">
                                <StackPanel Spacing="2" Padding="0,8,0,8">
                                    <TextBlock>
                                        <Run Text="{x:Bind Title}" FontWeight="SemiBold" />
                                        <Run Text="  page " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Run Text="{x:Bind PageNumber}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <!-- Empty for an ordinary hit, so this draws nothing. A hit on
                                             text the repair recovered says so, because the string may be
                                             a command somebody is about to send to an instrument. -->
                                        <Run Text="  " />
                                        <Run Text="{x:Bind SourceLabel}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind Snippet}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{x:Bind Path}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Opacity="0.6"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

        </TabView>

        <!-- Status line: which build this is, selectable so it can go into a bug report -->
        <TextBlock Grid.Row="4"
                   Text="{x:Bind ViewModel.Version}"
                   IsTextSelectionEnabled="True"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Opacity="0.6"
                   HorizontalAlignment="Right" />
    </Grid>
</Page>
