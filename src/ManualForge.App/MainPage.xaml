<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ManualForge.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ManualForge.Shell.ViewModels"
    xmlns:pipeline="using:ManualForge.Core.Pipeline"
    xmlns:indexing="using:ManualForge.Core.Indexing"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Folder, and what to do with it -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                PlaceholderText="Folder of PDFs"
                IsReadOnly="True"
                Text="{x:Bind ViewModel.Folder, Mode=OneWay}" />

            <Button Grid.Column="1" Content="Browse…" Click="BrowseAsync" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
            <Button Grid.Column="2" Content="Survey" Command="{x:Bind ViewModel.SurveyCommand}" />
            <Button Grid.Column="3" Content="Run" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RunCommand}" />
            <Button Grid.Column="4" Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
            <CheckBox Grid.Column="5" Content="Dry run" IsChecked="{x:Bind ViewModel.DryRun, Mode=TwoWay}" VerticalAlignment="Center" />
        </Grid>

        <!-- Status and overall progress -->
        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
            <ProgressBar Value="{x:Bind ViewModel.FileProgress, Mode=OneWay}" Maximum="100" />
        </StackPanel>

        <!-- Live counters, throughput, and the card -->
        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Files" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}">
                    <Run Text="{x:Bind ViewModel.FilesDone, Mode=OneWay}" />
                    <Run Text="/" />
                    <Run Text="{x:Bind ViewModel.FilesTotal, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{x:Bind ViewModel.CurrentFile, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                <TextBlock Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Pages" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}">
                    <Run Text="{x:Bind ViewModel.PagesDone, Mode=OneWay}" />
                    <Run Text="/" />
                    <Run Text="{x:Bind ViewModel.PagesTotal, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7">
                    <Run Text="{x:Bind ViewModel.PagesPerMinute, Mode=OneWay}" />
                    <Run Text="pages/min" />
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="2" MinWidth="220">
                <TextBlock Text="GPU" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <TextBlock Text="{x:Bind ViewModel.GpuStatus, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="busy" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <ProgressBar Grid.Column="1" Value="{x:Bind ViewModel.GpuUtilisation, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="vram" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <ProgressBar Grid.Column="1" Value="{x:Bind ViewModel.VramUsedPercent, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- The summary before committing, then what happened -->
        <TabView Grid.Row="3" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False">

            <TabViewItem Header="Classes" IsClosable="False">
                <Grid RowSpacing="8" Padding="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        TextWrapping="Wrap"
                        Opacity="0.8"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Survey classifies without changing anything. Choose what happens to each class before running." />

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Summary, Mode=OneWay}" SelectionMode="None">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="12,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Class" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Files" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Pages" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Action" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="What it means" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClassSummaryRow">
                                <Grid ColumnSpacing="12" MinHeight="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind TextClass}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Files}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Pages}" VerticalAlignment="Center" />
                                    <ComboBox
                                        Grid.Column="3"
                                        ItemsSource="{x:Bind AvailableActions}"
                                        SelectedItem="{x:Bind Action, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Explanation}" TextWrapping="Wrap" Opacity="0.75" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Results" IsClosable="False">
                <Grid RowSpacing="8" Padding="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <Button Content="Export CSV…" Click="ExportCsvAsync" />
                        <Button Content="Export JSON…" Click="ExportJsonAsync" />
                    </StackPanel>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="pipeline:FileOutcome">
                                <Grid ColumnSpacing="12" MinHeight="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Status}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind PageCount}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind WordsWritten}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Problems" IsClosable="False">
                <Grid RowSpacing="8" Padding="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button
                        Grid.Row="0"
                        Content="Forget files that are no longer on disk"
                        Command="{x:Bind ViewModel.TrimMissingCommand}" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Errors, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Search" IsClosable="False">
                <Grid RowSpacing="8" Padding="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="which pins carry the HP-IB handshake"
                            Text="{x:Bind Search.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{x:Bind Search.IsIdle, Mode=OneWay}"
                            KeyDown="SearchKeyDown" />

                        <Button
                            Grid.Column="1"
                            Content="Search"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind Search.SearchCommand}" />

                        <Button
                            Grid.Column="2"
                            Content="Build index"
                            Command="{x:Bind Search.BuildIndexCommand}" />
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        Text="{x:Bind Search.Status, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Opacity="0.8"
                        Style="{StaticResource CaptionTextBlockStyle}" />

                    <ListView Grid.Row="2" ItemsSource="{x:Bind Search.Results, Mode=OneWay}" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="indexing:SearchHit">
                                <StackPanel Spacing="2" Padding="0,8,0,8">
                                    <TextBlock>
                                        <Run Text="{x:Bind Title}" FontWeight="SemiBold" />
                                        <Run Text="  page " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Run Text="{x:Bind PageNumber}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind Snippet}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{x:Bind Path}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Opacity="0.6"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

        </TabView>
    </Grid>
</Page>
