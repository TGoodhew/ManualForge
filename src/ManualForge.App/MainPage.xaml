<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ManualForge.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ManualForge.Shell.ViewModels"
    xmlns:pipeline="using:ManualForge.Core.Pipeline"
    xmlns:indexing="using:ManualForge.Core.Indexing"
    xmlns:local="using:ManualForge.App"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Folder, and what to do with it -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                PlaceholderText="Folder of PDFs"
                IsReadOnly="True"
                AutomationProperties.Name="Library folder"
                local:Help.Text="The library: the folder of PDF manuals to work on. Choose it with Browse. The app opens on the folder it was last closed on, or the first time, on the library the installer recorded."
                Text="{x:Bind ViewModel.Folder, Mode=OneWay}" />

            <Button
                Grid.Column="1"
                Content="Browse…"
                Click="BrowseAsync"
                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                local:Help.Text="Choose the library folder." />
            <Button
                Grid.Column="2"
                Content="Survey"
                Command="{x:Bind ViewModel.SurveyCommand}"
                local:Help.Text="Classify every PDF in the library and show, on the Classes tab, what each needs and what is outstanding. Changes no PDF." />
            <Button
                Grid.Column="3"
                Content="Run"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.RunCommand}"
                local:Help.Text="Make searchable copies of the files the Classes tab says need work. Each original is moved, unchanged, into the _Originals folder, and an interrupted run carries on where it stopped." />
            <Button
                Grid.Column="4"
                Content="Cancel"
                Command="{x:Bind ViewModel.CancelCommand}"
                local:Help.Text="Stop the run after the page in flight. Pages already read are kept, so running again carries on from there." />
            <CheckBox
                Grid.Column="5"
                Content="Dry run"
                IsChecked="{x:Bind ViewModel.DryRun, Mode=TwoWay}"
                VerticalAlignment="Center"
                local:Help.Text="Read the files as a run would and report what each would gain, but move or replace nothing." />
        </Grid>

        <!-- Status and overall progress -->
        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
            <ProgressBar Value="{x:Bind ViewModel.FileProgress, Mode=OneWay}" Maximum="100" />
        </StackPanel>

        <!-- Live counters, throughput, and the card -->
        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" local:Help.Text="Files finished of the files this run will work on, with the one being read now and the page it has reached.">
                <TextBlock Text="Files" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}">
                    <Run Text="{x:Bind ViewModel.FilesDone, Mode=OneWay}" />
                    <Run Text="/" />
                    <Run Text="{x:Bind ViewModel.FilesTotal, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{x:Bind ViewModel.CurrentFile, Mode=OneWay}" local:Help.Text="{x:Bind ViewModel.CurrentFile, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                <TextBlock Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
            </StackPanel>

            <StackPanel Grid.Column="1" local:Help.Text="Pages read of the pages this run will read, and how many it is reading a minute.">
                <TextBlock Text="Pages" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}">
                    <Run Text="{x:Bind ViewModel.PagesDone, Mode=OneWay}" />
                    <Run Text="/" />
                    <Run Text="{x:Bind ViewModel.PagesTotal, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7">
                    <Run Text="{x:Bind ViewModel.PagesPerMinute, Mode=OneWay}" />
                    <Run Text="pages/min" />
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="2" MinWidth="220" local:Help.Text="The graphics card ManualForge reads pages on: how busy it is and how much of its memory is in use, by everything on the PC, updated every 2 seconds.">
                <TextBlock Text="GPU" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <TextBlock Text="{x:Bind ViewModel.GpuStatus, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="busy" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <ProgressBar Grid.Column="1" Value="{x:Bind ViewModel.GpuUtilisation, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="vram" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <ProgressBar Grid.Column="1" Value="{x:Bind ViewModel.VramUsedPercent, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- The summary before committing, then what happened -->
        <TabView Grid.Row="3" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False">

            <TabViewItem Header="Classes" IsClosable="False" local:Help.Text="What the survey found: the library's files by class, how many are done, and what a run will do to the rest.">
                <Grid RowSpacing="8" Padding="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        TextWrapping="Wrap"
                        Opacity="0.8"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Survey classifies without changing anything. Choose an action for each class, then Run." />

                    <ListView Grid.Row="1" AutomationProperties.Name="Classes" ItemsSource="{x:Bind ViewModel.Summary, Mode=OneWay}" SelectionMode="None">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="12,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Class" FontWeight="SemiBold" local:Help.Text="What each file was when it was first classified: whether it had a text layer, and how good it was. A finished file keeps its class." />
                                    <TextBlock Grid.Column="1" Text="Files" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Pages" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Done" FontWeight="SemiBold" local:Help.Text="Files of this class already finished. A run leaves them alone." />
                                    <TextBlock Grid.Column="4" Text="Action" FontWeight="SemiBold" local:Help.Text="What a run does to the files of this class that are not done yet." />
                                    <TextBlock Grid.Column="5" Text="What it means" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClassSummaryRow">
                                <Grid ColumnSpacing="12" MinHeight="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind TextClass}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Files}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Pages}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Done}" VerticalAlignment="Center" />
                                    <ComboBox
                                        Grid.Column="4"
                                        ItemsSource="{x:Bind AvailableActions}"
                                        SelectedItem="{x:Bind SelectedAction, Mode=TwoWay}"
                                        AutomationProperties.Name="{x:Bind ActionLabel}"
                                        local:Help.Text="Skip leaves these files untouched. Ocr reads them and adds a hidden text layer. StripAndRedo removes the hidden text layer they already have, then reads them and adds a new one. Applies to the files not done yet."
                                        HorizontalAlignment="Stretch" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind Explanation}" TextWrapping="Wrap" Opacity="0.75" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Results" IsClosable="False" local:Help.Text="What the last run did, file by file, with a report to export.">
                <Grid RowSpacing="8" Padding="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <Button Content="Export CSV…" Click="ExportCsvAsync" local:Help.Text="Save this run's results as a spreadsheet: one row per file, with its class, action, status, pages, words, alignment, time taken and any error." />
                        <Button Content="Export JSON…" Click="ExportJsonAsync" local:Help.Text="Save this run's results as JSON, with the same fields as the CSV." />
                    </StackPanel>

                    <ListView Grid.Row="1" AutomationProperties.Name="Results" ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="pipeline:FileOutcome">
                                <Grid ColumnSpacing="12" MinHeight="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Path}" local:Help.Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Status}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind PageCount}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind WordsWritten}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Problems" IsClosable="False" local:Help.Text="Errors from the last survey or run, files that cannot be opened, and files that have gone.">
                <Grid RowSpacing="8" Padding="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button
                        Grid.Row="0"
                        Content="Trim"
                        local:Help.Text="Forget manuals that are no longer on disk: in the work queue, the audit and the search index, so search stops returning them. Nothing on disk is touched."
                        Command="{x:Bind ViewModel.TrimMissingCommand}" />
                    <ListView Grid.Row="1" AutomationProperties.Name="Problems" ItemsSource="{x:Bind ViewModel.Errors, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Doctor" IsClosable="False" local:Help.Text="Find pages whose text misses what is printed on them, look at them, and recover their text for search.">
                <Grid RowSpacing="8" Padding="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- What to do. Reading the audit is free; auditing is minutes; recovering is
                         GPU time, so it is the one with the accent on it and a count beside it. -->
                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Content="Read audit"
                            Command="{x:Bind Doctor.RefreshCommand}"
                            local:Help.Text="Show what the last audit found, from its saved findings. Changes nothing." />

                        <Button
                            Grid.Column="1"
                            Content="Audit folder"
                            Command="{x:Bind Doctor.AuditCommand}"
                            local:Help.Text="Find pages whose text layer misses what is printed on them, such as labels on schematics and tables drawn as graphics, which search therefore cannot find. Changes nothing. Files unchanged since the last audit are only checked; a first audit of a whole library takes about an hour." />

                        <Button
                            Grid.Column="2"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind Doctor.RepairCommand}"
                            local:Help.Text="Read the flagged pages of the ticked documents and keep the text found, for search. No PDF is changed. Then build the index on the Search tab so search can find it.">
                            <TextBlock>
                                <Run Text="Recover text" />
                                <Run Text="(" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Run Text="{x:Bind Doctor.SelectedCount, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Run Text=")" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                        </Button>

                        <Button
                            Grid.Column="3"
                            Content="Stop"
                            Command="{x:Bind Doctor.CancelCommand}"
                            local:Help.Text="Stop the audit or the recovery after the page in flight. What is already done is kept." />

                        <!-- Over a whole library the list runs to several hundred rows, and the
                             difference between "repair what you suggested" and "repair these three"
                             should not be three hundred clicks. -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" Margin="16,0,0,0">
                            <Button Content="All" Command="{x:Bind Doctor.SelectEverythingCommand}" local:Help.Text="Tick every document that still has pages to recover. Documents with nothing left to do stay unticked." />
                            <Button Content="None" Command="{x:Bind Doctor.SelectNothingCommand}" local:Help.Text="Untick every document." />
                        </StackPanel>

                        <CheckBox
                            Grid.Column="5"
                            Content="Include scanned pages"
                            IsChecked="{x:Bind Doctor.IncludeScannedPages, Mode=TwoWay}"
                            IsEnabled="{x:Bind Doctor.IsIdle, Mode=OneWay}"
                            local:Help.Text="Also redo scanned pages whose earlier OCR missed lettering. A different problem, and on a large library, hours of work." />
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        Text="{x:Bind Doctor.Headline, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}" />

                    <StackPanel Grid.Row="2" Spacing="4">
                        <TextBlock
                            Text="{x:Bind Doctor.Status, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Opacity="0.8"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <ProgressBar
                            Value="{x:Bind Doctor.WorkProgress, Mode=OneWay}"
                            IsIndeterminate="{x:Bind Doctor.IsWorkIndeterminate, Mode=OneWay}"
                            Maximum="100"
                            Visibility="{x:Bind Doctor.IsBusy, Mode=OneWay}" />
                    </StackPanel>

                    <!-- The findings on the left, and on the right the page the detector was
                         looking at, so nobody has to take its word for it before spending GPU
                         time on what it said. -->
                    <Grid Grid.Row="3" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="12" Padding="12,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="Document" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="Why" Style="{StaticResource CaptionTextBlockStyle}" local:Help.Text="Why the document was flagged. Drawn, never text: much of it is drawn rather than typeset, and extracts as nothing. Scanned, OCR gaps: a scan whose earlier OCR missed much of its lettering, usually schematics, tables and figure labels. Figure pages: a few figures carry lettering the text does not hold." />
                                <TextBlock Grid.Column="3" Text="Flagged" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" local:Help.Text="Pages whose text misses lettering drawn on them. Their numbers are listed under the document's name." />
                                <TextBlock Grid.Column="4" Text="Drawn" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" local:Help.Text="Of the flagged pages, those drawn as graphics rather than scanned." />
                                <TextBlock Grid.Column="5" Text="Recovered" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" local:Help.Text="Flagged pages whose text has been recovered, of all the flagged pages." />
                            </Grid>

                            <ListView
                                Grid.Row="1"
                                AutomationProperties.Name="Documents to check"
                                ItemsSource="{x:Bind Doctor.Documents, Mode=OneWay}"
                                SelectedItem="{x:Bind Doctor.SelectedDocument, Mode=TwoWay}"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DoctorRow">
                                        <Grid ColumnSpacing="12" MinHeight="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox
                                                Grid.Column="0"
                                                MinWidth="0"
                                                AutomationProperties.Name="{x:Bind TickLabel}"
                                                local:Help.Text="Tick to include this document in Recover text. Ticking it also chooses it for Show."
                                                IsChecked="{x:Bind Selected, Mode=TwoWay}" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}" local:Help.Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{x:Bind PageRanges}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Opacity="0.6"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{x:Bind Kind}" TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.8" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind FlaggedPages}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind DrawnPages}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind Progress, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <ListView
                                Grid.Row="2"
                                MaxHeight="120"
                                ItemsSource="{x:Bind Doctor.Recovered, Mode=OneWay}"
                                AutomationProperties.Name="Pages recovered"
                                local:Help.Text="Each page Recover text has read, newest first, with the words it found."
                                SelectionMode="None" />
                        </Grid>

                        <Grid Grid.Column="1" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Show page" VerticalAlignment="Center" />
                                <NumberBox
                                    Grid.Column="1"
                                    Minimum="1"
                                    SpinButtonPlacementMode="Compact"
                                    AutomationProperties.Name="Page to show"
                                    local:Help.Text="The page Show draws. Choosing a document starts it at that document's first flagged page."
                                    Value="{x:Bind Doctor.ExplainPage, Mode=TwoWay}" />
                                <Button Grid.Column="2" Content="Show" Command="{x:Bind Doctor.ExplainCommand}" local:Help.Text="Draw the page as the audit saw it. Click or tick a document first; it starts at the document's first flagged page. Drag the picture to move around it." />
                            </Grid>

                            <!-- What the picture means for search, and whether this page needs anything (#74). -->
                            <TextBlock
                                Grid.Row="1"
                                Text="{x:Bind Doctor.PageExplanation, Mode=OneWay}"
                                Visibility="{x:Bind Doctor.HasPageExplanation, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}" />

                            <Border
                                Grid.Row="2"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid>
                                    <ScrollViewer x:Name="DiagnosticScroller" ZoomMode="Enabled" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto">
                                        <Image x:Name="DiagnosticImage" Stretch="Uniform" />
                                    </ScrollViewer>
                                    <TextBlock
                                        Text="{x:Bind Doctor.ExplainHint, Mode=OneWay}"
                                        Visibility="{x:Bind Doctor.HasNoPicture, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Opacity="0.7"
                                        Margin="16"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        TextAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Search" IsClosable="False" local:Help.Text="Search every page of every manual in the library, and build its index.">
                <Grid RowSpacing="8" Padding="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="which pins carry the HP-IB handshake"
                            AutomationProperties.Name="Search the library"
                            local:Help.Text="Words to find on any page of any manual. Command syntax pasted from a manual is understood as notation: a colon means all of these, {a|b} either, and &lt;N&gt; a placeholder. Press Enter to search."
                            Text="{x:Bind Search.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{x:Bind Search.IsIdle, Mode=OneWay}"
                            KeyDown="SearchKeyDown" />

                        <Button
                            Grid.Column="1"
                            Content="Search"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind Search.SearchCommand}"
                            local:Help.Text="Search every page of every manual in the library's index, best matches first. A hit marked OCR matched text ManualForge read off the page image: check it against the page before relying on it." />

                        <Button
                            Grid.Column="2"
                            Content="Build index"
                            Command="{x:Bind Search.BuildIndexCommand}"
                            local:Help.Text="Build or update the library's search index, including text recovered on the Doctor tab. The first build reads every PDF; after that, only new and changed ones are read again." />
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        Text="{x:Bind Search.Status, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Opacity="0.8"
                        Style="{StaticResource CaptionTextBlockStyle}" />

                    <ListView Grid.Row="2" AutomationProperties.Name="Search results" ItemsSource="{x:Bind Search.Results, Mode=OneWay}" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="indexing:SearchHit">
                                <StackPanel Spacing="2" Padding="0,8,0,8">
                                    <TextBlock>
                                        <Run Text="{x:Bind Title}" FontWeight="SemiBold" />
                                        <Run Text="  page " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Run Text="{x:Bind PageNumber}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <!-- Empty for an ordinary hit, so this draws nothing. A hit on
                                             text the repair recovered says so, because the string may be
                                             a command somebody is about to send to an instrument. -->
                                        <Run Text="  " />
                                        <Run Text="{x:Bind SourceLabel}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind Snippet}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{x:Bind Path}"
                                        local:Help.Text="{x:Bind Path}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Opacity="0.6"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

        </TabView>

        <!-- Status line: which build this is, selectable so it can go into a bug report -->
        <TextBlock Grid.Row="4"
                   Text="{x:Bind ViewModel.Version}"
                   local:Help.Text="Which build of ManualForge is running, and the commit it was built from. Select it to copy it into a bug report."
                   IsTextSelectionEnabled="True"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Opacity="0.6"
                   HorizontalAlignment="Right" />
    </Grid>
</Page>
