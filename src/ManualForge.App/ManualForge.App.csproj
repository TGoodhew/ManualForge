<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ManualForge.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!--
      Unpackaged, and self-contained on the Windows App SDK.

      MSIX packaging refuses this application outright: PaddleOcrNet pulls in both the CPU and the
      GPU builds of ONNX Runtime, and each ships its own onnxruntime.dll, which the packaging step
      sees as two files claiming one destination. That is the same collision that kept DirectML out.
      Unpackaged sidesteps it, needs no install, and matches how the command line is already run.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Built by tools\build-icon.ps1 from art\icon (#67). An unpackaged app has no use for the
         template's tile and splash images, so there are none. -->
    <Content Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <!--
    Unpackaged, nothing copies these beside the program unless told to, and the window loads its icon
    from Assets\AppIcon.ico at run time: every published build so far had none. The same icon is built
    into the program file, which is what the Start menu entry and the taskbar show (#26).
  -->
  <ItemGroup>
    <Content Update="Assets\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ManualForge.Shell\ManualForge.Shell.csproj" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" />
  </ItemGroup>

  <!--
    The installer (#26) publishes the window framework-dependent, on the shared .NET runtime and Windows
    App Runtime it chains in, into one folder with the command line and the MCP server. In that mode the
    publish leaves out the app's own resource index, ManualForge.App.pri, and without it MainWindow's
    XAML cannot be found: the window dies at startup with 0xC000027B and "XAML parsing failed". Copied
    in here. A self-contained publish needs nothing, and is untouched.
  -->
  <Target Name="PublishAppResourceIndex" AfterTargets="Publish" Condition="'$(WindowsAppSDKSelfContained)' != 'true'">
    <Copy SourceFiles="$(OutDir)$(TargetName).pri" DestinationFolder="$(PublishDir)" Condition="Exists('$(OutDir)$(TargetName).pri')" />
    <Error Text="$(TargetName).pri was not built, so the published window could not find its XAML." Condition="!Exists('$(OutDir)$(TargetName).pri')" />
  </Target>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>

    <!--
      Self-contained, overriding Directory.Build.props. This is the window: it is started by
      double-clicking rather than from a developer's shell, so it cannot assume a .NET runtime is
      installed, and the README promises it needs no install. The command line and the MCP server
      are framework-dependent as before, because whoever runs those has a shell.
    -->
    <SelfContained>true</SelfContained>

    <!--
      Not trimmed, although the template turns it on for Release and a self-contained publish now
      permits it. WinUI resolves XAML types by name at run time, so the trimmer cannot see who uses
      what, and the failure mode is not a build error - it is the window dying at startup with
      0xC000027B and nothing else. This project has already lost an afternoon to exactly that
      exception from a missing converter. The download is larger; the alternative is a class of bug
      that only ever appears in the published build.
    -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
