<?xml version="1.0" encoding="utf-8"?>
<!--
  PaddleOcrNet comes from our fork (github.com/TGoodhew/PaddleOcrNet, branch feature/tensorrt) until its
  TensorRT support is released upstream (FarhanLodi/PaddleOcrNet#11; #53 here). The packages are built by
  tools/build-paddleocrnet.ps1 into packages/ and committed, so a clone builds with nothing else installed.
  The mapping makes PaddleOcrNet come only from there, never from nuget.org's packages of the same name.
  When upstream releases it, delete the "local" source and its mapping, and pin the released version.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="PaddleOcrNet" />
      <package pattern="PaddleOcrNet.Gpu" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
