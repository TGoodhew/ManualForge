<Project>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(IsTestProject)' != 'true'">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Product>ManualForge</Product>
    <Company>Tony Goodhew</Company>
    <Copyright>Copyright (c) Tony Goodhew</Copyright>
    <Version>0.1.0</Version>
    <!-- PDFium / ONNX Runtime native assets are x64-only; AnyCPU would silently pick wrong RIDs. -->
    <ManagedRuntimeMarshalling>false</ManagedRuntimeMarshalling>
  </PropertyGroup>

</Project>
