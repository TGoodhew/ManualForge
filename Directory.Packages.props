<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="OCR">
    <PackageVersion Include="PaddleOcrNet" Version="2.2.0" />
    <PackageVersion Include="PaddleOcrNet.Gpu" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup Label="PDF">
    <!-- Rasterisation (PDFium). -->
    <PackageVersion Include="PDFtoImage" Version="5.4.0" />
    <!-- Inspection / text extraction / verification. -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <!-- Writing: text-layer overlay and lossless page import. -->
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup Label="Index and state">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Named explicitly for two reasons: it is the e_sqlite3 build that carries FTS5, and
         pinning it to 2.1.13 clears GHSA-2m69-gcr7-jv3q, which the versions Microsoft.Data.Sqlite
         pulls in by default (2.1.11 / 2.1.12) are still flagged for. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup Label="Platform">
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <!-- Logging. The JSON formatter is in Serilog itself, so writing JSON lines needs no
         formatting package on top of these three. -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Shell">
    <!-- WinUI 3 and the Windows App SDK are named in the specification. CommunityToolkit.Mvvm is
         not, and was approved separately: its source generators are what keep a view model a
         description of state rather than a page of property boilerplate. -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.3.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Label="MCP">
    <!-- Anthropic's own C# SDK for the Model Context Protocol, approved separately. It carries the
         handshake, capability negotiation and tool schema generation, which a hand-rolled server
         would have to keep in step with the protocol by itself. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
